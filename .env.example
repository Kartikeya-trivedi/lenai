# ============================================================
# LenAI Media Inference Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_USER=lenai
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=lenai
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- MinIO Object Storage ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password_here
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET_INPUTS=inputs
MINIO_BUCKET_OUTPUTS=outputs

# ---- API Server ----
API_SECRET_KEY=changeme_api_secret_key_min_32_characters
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000"]

# ---- Self-Hosted Model Endpoints (Docker internal network) ----
SD_API_URL=http://sd:7860
WHISPER_API_URL=http://whisper:9000
KOKORO_API_URL=http://kokoro:8880
VLLM_API_URL=http://vllm:8000

# ---- RAG Pipeline ----
QDRANT_URL=http://qdrant:6333
EMBEDDING_MODEL=intfloat/multilingual-e5-large
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_MODEL_LARGE=google/gemma-2-27b-it
RAG_CONFIDENCE_THRESHOLD=0.3
RAG_TOP_K=10
RAG_RERANK_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ---- Storage & Cleanup ----
OUTPUT_URL_TTL_HOURS=24
MAX_UPLOAD_SIZE_MB=100
CLEANUP_INTERVAL_MINUTES=60

# ---- Webhook ----
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_SECONDS=30

# ---- Rate Limiting ----
DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_MONTHLY_CAP=10000

# ---- Modal (optional serverless scaling) ----
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=dev

# ---- GPU Config (set USE_GPU=true for GPU-accelerated containers) ----
USE_GPU=false
CUDA_VISIBLE_DEVICES=0
